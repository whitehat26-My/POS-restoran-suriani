<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
          The tablet's own web server, so a phone on the shop WiFi can order
          when the internet is down.

          specialUse rather than dataSync on purpose: Android 15 caps
          dataSync foreground services at six hours in any twenty-four, and a
          restaurant's service is longer than that. The cap would shut
          ordering off at the busiest hour of the evening with no error
          anywhere for anyone to see.
        -->
        <service
            android:name=".LocalServerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Serves the customer ordering page to phones on the restaurant's own WiFi for the whole of a trading day, so the shop keeps taking orders during an internet outage." />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      The local ordering server.

      A foreground service is the only way Android lets an app hold a
      listening socket for a ten-hour shift; POST_NOTIFICATIONS is what makes
      its notification visible on Android 13+, and the notification is how
      staff can see the outage door is open. ACCESS_WIFI_STATE and WAKE_LOCK
      are for the WifiLock that stops the radio dozing between orders on a
      quiet afternoon.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Printing.

      LAN is the fast path and Bluetooth is what keeps the kitchen printing
      when the router dies, so both are required rather than optional.

      Android 12 (API 31) split the old BLUETOOTH/BLUETOOTH_ADMIN install-time
      permissions into runtime ones. Both eras are still in the field on the
      cheap tablets this runs on, so both are declared and the old pair is
      capped at API 30.

      neverForLocation is asserted on BLUETOOTH_SCAN: this app pairs with a
      printer on the counter and has no interest in where anybody is, and
      without it Android would demand the location permission as well.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- The tablet is the till, not a phone that happens to have the app. -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
</manifest>
