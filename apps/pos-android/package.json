{
  "name": "@suriani/pos-android",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The cashier tablet: the POS web app in a Capacitor shell, plus the native transports a browser can never have — raw TCP to the printer, and Bluetooth when the router dies.",
  "scripts": {
    "web": "pnpm --filter @suriani/pos exec vite build --base ./ --outDir ../pos-android/www --emptyOutDir",
    "sync": "pnpm --filter @suriani/pos-android web && cap sync android",
    "apk": "pnpm --filter @suriani/pos-android sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
